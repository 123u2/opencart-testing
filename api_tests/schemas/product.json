{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cart Response Schema (OpenCart 4.x)",
  "description": "OpenCart API: api/sale/cart 响应结构校验（契约测试用）",
  "type": "object",
  "required": ["products", "totals"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cart_id", "product_id", "name", "quantity", "price", "total"],
        "properties": {
          "cart_id": {"type": ["string", "integer"]},
          "product_id": {"type": ["string", "integer"]},
          "name": {"type": "string"},
          "model": {"type": "string"},
          "option": {"type": "array"},
          "subscription": {"type": "string"},
          "quantity": {"type": ["string", "integer"]},
          "stock": {"type": "boolean"},
          "minimum": {},
          "reward": {},
          "price": {"type": "string"},
          "total": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "vouchers": {
      "type": "array"
    },
    "totals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "title": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "shipping_required": {
      "type": "boolean"
    },
    "success": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
